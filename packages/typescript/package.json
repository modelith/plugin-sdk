{
  "name": "@modelith/plugin-sdk",
  "version": "0.1.0",
  "description": "Types and helpers for building Modelith plugins",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/modelith/plugin-sdk.git",
    "directory": "packages/typescript"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema/*": "./schema/*"
  },
  "files": [
    "dist",
    "schema"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && rm -rf schema && cp -r ../../schema schema",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "ajv": "^8.20.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
